# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET -- server-side only. Never prefix this with NEXT_PUBLIC_ or it will
# be bundled into client JS and exposed in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
